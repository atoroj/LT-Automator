# Variables del servidor. Se copia a servidor/.env (excluido de git, permisos 600).

# Clave de la API de IA (Anthropic). Alternativa: guardarla desde la pantalla «IA» de la aplicación.
# Si la pones aquí, tiene prioridad sobre la guardada en la aplicación.
ANTHROPIC_API_KEY=

# Google Drive (rclone). Nombre del remoto creado con «rclone config» y carpeta raíz en Drive.
# Para cambiar de cuenta de Drive: vuelve a ejecutar la configuración de rclone (DESPLIEGUE.md).
DRIVE_REMOTO=drive
DRIVE_CARPETA=GESTOR HIPOTECARIO
INTERVALO_DRIVE_SEGUNDOS=120

# Deben coincidir con [carpetas] de servidor/config.toml (si no los cambias, déjalos así).
CARPETA_RAIZ=GESTOR HIPOTECARIO
CARPETA_ENTRADA=00 - ENTRADA
CARPETA_EXPEDIENTES=02 - EXPEDIENTES
CARPETA_INCIDENCIAS=03 - INCIDENCIAS

TZ=Europe/Madrid
